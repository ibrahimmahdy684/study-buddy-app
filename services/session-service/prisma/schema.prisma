generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SessionType {
  ONLINE
  IN_PERSON
}

enum SessionStatus {
  SCHEDULED
  CANCELLED
  COMPLETED
}

enum SessionInviteStatus {
  PENDING
  ACCEPTED
  DECLINED
  CANCELLED
}

enum SessionJoinRequestStatus {
  PENDING
  APPROVED
  DECLINED
  CANCELLED
}

enum ParticipantRole {
  CREATOR
  PARTICIPANT
}

model StudySession {
  id          String   @id @default(uuid())
  topic       String   @db.VarChar(255)
  description String?
  date        DateTime
  /// Duration in minutes
  duration    Int
  type        SessionType
  status      SessionStatus @default(SCHEDULED)
  location    String?
  
  creatorId   String
  
  // ContactInfo for the creator (stored at creation time for when messaging isn't available)
  creatorEmail     String?
  creatorPhoneNumber String?
  
  participants SessionParticipant[]
  invites     SessionInvite[]
  joinRequests SessionJoinRequest[]
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("study_sessions")
  @@index([creatorId])
  @@index([date])
  @@index([status])
}

model SessionParticipant {
  id          String   @id @default(uuid())
  
  sessionId   String
  session     StudySession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  
  userId      String
  role        ParticipantRole
  joinedAt    DateTime @default(now())
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([sessionId, userId])
  @@map("session_participants")
  @@index([sessionId])
  @@index([userId])
}

model SessionInvite {
  id            String               @id @default(uuid())
  sessionId     String
  session       StudySession         @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  invitedUserId String
  invitedById   String
  status        SessionInviteStatus  @default(PENDING)
  createdAt     DateTime             @default(now())
  respondedAt   DateTime?

  @@unique([sessionId, invitedUserId])
  @@index([sessionId])
  @@index([invitedUserId])
}

model SessionJoinRequest {
  id            String                    @id @default(uuid())
  sessionId     String
  session       StudySession              @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  requesterId   String
  reviewedById  String?
  status        SessionJoinRequestStatus  @default(PENDING)
  createdAt     DateTime                  @default(now())
  respondedAt   DateTime?

  @@unique([sessionId, requesterId])
  @@index([sessionId])
  @@index([requesterId])
}
